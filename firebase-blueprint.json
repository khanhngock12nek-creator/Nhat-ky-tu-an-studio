{
  "entities": {
    "Character": {
      "title": "Character",
      "description": "Prisoner / Character entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "prisonId": { "type": "string" },
        "name": { "type": "string" },
        "age": { "type": "string" },
        "subtitle": { "type": "string" },
        "origin": { "type": "string" },
        "crime": { "type": "string" },
        "rarity": { "type": "string" },
        "loyalty": { "type": "number" },
        "danger": { "type": "number" },
        "sentenceTerm": { "type": "string" },
        "possession": { "type": "string" },
        "heartbeat": { "type": "number" },
        "loveRate": { "type": "string" },
        "zone": { "type": "string" },
        "genres": { "type": "array" },
        "backstory": { "type": "string" },
        "firstMessage": { "type": "string" },
        "chatLink": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "avatarGradient": { "type": "string" },
        "status": { "type": "string" },
        "likes": { "type": "number" },
        "loveCount": { "type": "number" },
        "loveMessages": { "type": "array" },
        "voiceActor": { "type": "string" },
        "voiceAudioUrl": { "type": "string" },
        "voiceLine": { "type": "string" },
        "voiceDuration": { "type": "string" },
        "voicePitch": { "type": "number" },
        "voiceRate": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "prisonId"]
    },
    "Letter": {
      "title": "Letter",
      "description": "Postcard / review letter entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderName": { "type": "string" },
        "content": { "type": "string" },
        "likes": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "content"]
    }
  },
  "firestore": {
    "/characters/{charId}": {
      "schema": { "$ref": "#/entities/Character" },
      "description": "Characters / Prisoners collection"
    },
    "/letters/{letterId}": {
      "schema": { "$ref": "#/entities/Letter" },
      "description": "Letters / Postcards collection"
    }
  }
}
