rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /characters/{charId} {
      allow read, write: if true;
    }
    match /letters/{letterId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
